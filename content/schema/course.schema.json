{
  "title": "course.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^ap-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "shortTitle": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "enum": [
        "arts",
        "english",
        "history",
        "math-cs",
        "sciences",
        "world-languages",
        "capstone"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "beta",
        "live"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "companion": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "url",
        "description"
      ],
      "additionalProperties": false
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[0-9A-Za-z.]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "units": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "examWeight": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "topics": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "ced": {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d+$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "links": {
                  "maxItems": 10,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "url": {
                        "type": "string",
                        "format": "uri"
                      }
                    },
                    "required": [
                      "label",
                      "url"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "title"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "topics"
        ],
        "additionalProperties": false
      }
    },
    "mock": {
      "type": "object",
      "properties": {
        "sections": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "mcq",
                  "frq"
                ]
              },
              "format": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "count": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "minutes": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              },
              "calculator": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "count",
              "minutes"
            ],
            "additionalProperties": false
          }
        },
        "cutoffs": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": [
        "sections"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "title",
    "subject",
    "status",
    "description",
    "units"
  ],
  "additionalProperties": false
}
