{
  "title": "questions/*.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "stimuli": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "table": {
            "type": "object",
            "properties": {
              "caption": {
                "type": "string",
                "minLength": 1
              },
              "columns": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "key",
                    "label"
                  ],
                  "additionalProperties": false
                }
              },
              "rows": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number"
                    ]
                  }
                }
              }
            },
            "required": [
              "caption",
              "columns",
              "rows"
            ],
            "additionalProperties": false
          },
          "image": {
            "type": "object",
            "properties": {
              "src": {
                "type": "string",
                "pattern": "^assets\\/(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
              },
              "alt": {
                "type": "string",
                "minLength": 1
              },
              "caption": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "src",
              "alt"
            ],
            "additionalProperties": false
          },
          "audio": {
            "type": "object",
            "properties": {
              "src": {
                "type": "string",
                "pattern": "^assets\\/(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
              },
              "transcript": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "src",
              "transcript"
            ],
            "additionalProperties": false
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    "questions": {
      "default": [],
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "topics": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "difficulty": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "stimuli": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              },
              "type": {
                "type": "string",
                "const": "mcq"
              },
              "stem": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "minItems": 4,
                "maxItems": 5,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "enum": [
                        "a",
                        "b",
                        "c",
                        "d",
                        "e"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "why": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "text",
                    "why"
                  ],
                  "additionalProperties": false
                }
              },
              "answer": {
                "type": "string",
                "enum": [
                  "a",
                  "b",
                  "c",
                  "d",
                  "e"
                ]
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "topics",
              "difficulty",
              "type",
              "stem",
              "options",
              "answer",
              "explanation"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "topics": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "difficulty": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "stimuli": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              },
              "type": {
                "type": "string",
                "const": "frq"
              },
              "format": {
                "default": "frq",
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "minutes": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "parts": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "prompt": {
                      "type": "string",
                      "minLength": 1
                    },
                    "rubric": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "oneOf": [
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "point"
                              },
                              "id": {
                                "type": "string",
                                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                              },
                              "criterion": {
                                "type": "string",
                                "minLength": 1
                              },
                              "example": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "required": [
                              "kind",
                              "id",
                              "criterion"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "scale"
                              },
                              "id": {
                                "type": "string",
                                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                              },
                              "criterion": {
                                "type": "string",
                                "minLength": 1
                              },
                              "max": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 10
                              },
                              "levels": {
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              }
                            },
                            "required": [
                              "kind",
                              "id",
                              "criterion",
                              "max",
                              "levels"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      }
                    },
                    "maxPoints": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "id",
                    "prompt",
                    "rubric"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "topics",
              "difficulty",
              "type",
              "title",
              "minutes",
              "parts"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
