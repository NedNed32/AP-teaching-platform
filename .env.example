# Environment. Every variable is optional:
# with none set, the app runs in guest mode (no sign-in UI, embedded database).

# --- Accounts -----------------------------------------------------------------
# Enables accounts (email + password). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app. Optional locally; set it in production.
BETTER_AUTH_URL=http://localhost:3000

# Account emails (address confirmation, password reset) via Resend (optional).
# Without it, the links are printed to the server console. Fine locally,
# but server logs then contain live reset links, so configure email in production.
RESEND_API_KEY=
EMAIL_FROM="AP-Program <login@example.com>"

# --- Database -----------------------------------------------------------------
# Postgres connection string for production. When unset, an embedded PGlite
# database is created at PGLITE_DATA_DIR (default ./.data/pglite).
DATABASE_URL=
PGLITE_DATA_DIR=

# --- Content ------------------------------------------------------------------
# Courses with "status": "draft" appear in development only. Set to 1 to
# include them in a production build too (for previewing before launch).
SHOW_DRAFTS=
